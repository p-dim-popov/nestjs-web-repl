{
  "name": "remote-repl-workspace",
  "private": true,
  "description": "Workspace root for the remote-repl monorepo (see packages/).",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "example": "npm run example --workspace @remote-repl/nestjs",
    "example:express": "npm run example --workspace @remote-repl/express",
    "schema:check": "npm run schema:check --workspace @remote-repl/core",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3"
  }
}
